# Copy to ".env" before `docker compose up -d --build`.
# Everything below has a safe default; you only NEED to change things
# when you want real (non-mock) notifications.

# ---------- Security ----------
# MUST be 32+ characters. Auth-service and api-gateway MUST share the same value.
DPDMS_JWT_SECRET=dpdms-dev-secret-change-me-before-production-0123456789abcdef
MYSQL_ROOT_PASSWORD=Gr@nd$0n

# ---------- EMAIL (Todzani's alert-service) ----------
# false = mock mode: nothing is sent, every attempt still appears in the alert log.
# true  = real SMTP. Gmail: enable 2-step verification, create an App Password,
#         put it in SPRING_MAIL_PASSWORD (16 chars, no spaces).
ALERT_EMAIL_ENABLED=false
# provider=smtp (Gmail app password) | provider=sendgrid (Twilio SendGrid)
ALERT_EMAIL_PROVIDER=smtp
ALERT_EMAIL_FROM=dpdms-alerts@example.com
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Twilio SendGrid API key (only when ALERT_EMAIL_PROVIDER=sendgrid)
ALERT_SENDGRID_API_KEY=
# who receives flood/etc. alerts (comma separated)
ALERT_RECIPIENTS_EMAIL=

# ---------- WHATSAPP ----------
# provider=mock (default) | provider=meta (Meta Cloud API) | provider=twilio
ALERT_WHATSAPP_PROVIDER=mock
# --- Meta Cloud API (provider=meta) ---
ALERT_WHATSAPP_PHONE_NUMBER_ID=
ALERT_WHATSAPP_TOKEN=
# --- Twilio Programmable Messaging (provider=twilio) ---
# Console -> Account SID / Auth Token; sandbox sender is whatsapp:+14155238886
ALERT_TWILIO_ACCOUNT_SID=
ALERT_TWILIO_AUTH_TOKEN=
ALERT_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Twilio WhatsApp now requires a Content template SID (Content API, e.g. HXxxxx); upgrade needed if on trial
ALERT_TWILIO_CONTENT_SID=
ALERT_RECIPIENTS_WHATSAPP=

# ---------- TELEGRAM (easiest live demo) ----------
# 1) Telegram -> @BotFather -> /newbot -> copy token below
# 2) Telegram -> @userinfobot -> your chat id below
# 3) docker compose up -d (restart alert-service)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_RECIPIENTS_TELEGRAM=
